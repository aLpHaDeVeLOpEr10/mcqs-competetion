APP_NAME="MCQ Competition"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcq_competition
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure-only session cookie. Defaults to true when APP_URL is https; set it explicitly in production.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Competition platform (see config/competition.php)
COMPETITION_CURRENCY=PKR
COMPETITION_CURRENCY_MINOR_UNITS=100
COMPETITION_DISPLAY_TIMEZONE=Asia/Karachi
# Keep false until legal/compliance for real-money entries is confirmed.
COMPETITION_PAID_ENTRIES_ENABLED=false
# disabled | fake (test-mode only). Real gateways added in a later phase.
PAYMENT_GATEWAY=disabled

# Public contact form recipient. Leave empty to disable the form.
CONTACT_RECIPIENT_EMAIL=

# Require a verified email before entering competitions or transacting.
# Needs working mail delivery (MAIL_* settings). Signing in never requires it.
ACCOUNT_EMAIL_VERIFICATION=true

# Minutes a seat is held while an entry payment is pending.
ROOM_RESERVATION_MINUTES=10

# Laravel Reverb WebSocket server. Generate values with: php artisan reverb:install
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Production: browsers' origin host(s), comma separated (never * in production); Reverb listens on localhost behind nginx.
REVERB_ALLOWED_ORIGINS=*
# REVERB_SERVER_HOST=127.0.0.1

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Latency allowance (ms) after each question deadline.
COMPETITION_ANSWER_GRACE_MS=500

# Results and prizes (see docs/RESULTS.md)
RESULTS_AUTO_PUBLISH=true
PRIZE_PAYOUTS_ENABLED=false

# Wallet (see docs/WALLET.md). Adjustments stay off until finance procedures are agreed.
WALLET_ADJUSTMENTS_ENABLED=false
WALLET_MAX_ADJUSTMENT_MINOR=5000000

# Deposits (see docs/PAYMENTS.md). Real-money deposits stay OFF until the provider and
# jurisdiction permit this competition model.
DEPOSITS_ENABLED=false
DEPOSIT_MIN_MINOR=10000
DEPOSIT_MAX_MINOR=2500000
DEPOSIT_DAILY_MAX_MINOR=5000000
DEPOSIT_EXPIRES_MINUTES=30

# Simulated provider: local/testing ONLY (refused in production). Generate your own secret.
FAKE_GATEWAY_ENABLED=false
FAKE_GATEWAY_SECRET=
FAKE_GATEWAY_MERCHANT_ID=FAKE-MERCHANT
FAKE_GATEWAY_CACHE_STORE=database

# Entry-fee refund policy (see docs/ROOMS.md). Cancellations are always refunded in full.
ENTRY_FEE_REFUND_ON_WITHDRAWAL=true

# Prize payouts (see docs/PRIZES.md)
PRIZE_HOLD_WHILE_DISPUTED=true
PRIZE_TAX_WITHHOLDING_BP=0

# Notifications (see docs/NOTIFICATIONS.md). Email is queued: run php artisan queue:work.
NOTIFICATIONS_MAIL=true
NOTIFICATIONS_BROADCAST=true

# Withdrawals (see docs/WITHDRAWALS.md). Off until a permitted payout provider is configured.
WITHDRAWALS_ENABLED=false
WITHDRAWAL_PAYOUT_GATEWAY=disabled
WITHDRAWAL_MIN_MINOR=50000
WITHDRAWAL_MAX_MINOR=2500000
WITHDRAWAL_DAILY_MAX_MINOR=5000000
WITHDRAWAL_MAX_PENDING=1
WITHDRAWAL_FEE_FLAT_MINOR=0
WITHDRAWAL_FEE_BP=0
WITHDRAWAL_DESTINATION_COOLDOWN_HOURS=24
FAKE_PAYOUT_ENABLED=false
FAKE_PAYOUT_SECRET=
FAKE_PAYOUT_CACHE_STORE=database

# Retention (see docs/REPORTS.md). Audit logs and financial records are kept permanently.
RETENTION_READ_NOTIFICATIONS_DAYS=180

# Security (see docs/SECURITY.md). Run `php artisan security:check` before going live.
# CSP: enforce | report-only | off. Extra origins are comma separated.
SECURITY_HEADERS=true
SECURITY_CSP=enforce
# Hosted-checkout origin of a real payment provider, once one is integrated.
SECURITY_CSP_FORM_ACTIONS=
# Extra WebSocket origins when browsers reach Reverb through a different public host, e.g. wss://ws.example.com
SECURITY_CSP_CONNECT=
SECURITY_HSTS_MAX_AGE=31536000
# Answers accepted faster than this (ms) are recorded as a low-severity review signal, never rejected.
SECURITY_RAPID_ANSWER_MS=400

# Queues and operations (see docs/OPERATIONS.md). Workers:
#   php artisan queue:work --queue=competition,default
#   php artisan queue:work database-long --queue=long --timeout=900
QUEUE_ENGINE=competition
QUEUE_DEFAULT=default
QUEUE_LONG_CONNECTION=database-long
DB_LONG_QUEUE_RETRY_AFTER=1000
QUEUE_MONITOR_MAX=200
OPS_TICK_STALE_SECONDS=30

# Admin dashboard all-time totals are reused for this many seconds (0 = always live). Display only.
CACHE_DASHBOARD_SECONDS=60

# Database session time zone (the app stores UTC).
DB_TIMEZONE=+00:00

# Real-money launch gate (config/compliance.php, docs/LAUNCH_READINESS.md). Real-money switches stay
# forced OFF until qualified legal/provider review is recorded here. Each CONFIRMED_* means: in place,
# or confirmed not required, by that review. Do not set these to make something "work".
COMPLIANCE_REAL_MONEY_APPROVED=false
COMPLIANCE_APPROVAL_REFERENCE=
COMPLIANCE_PERMITTED_JURISDICTIONS=PK
COMPLIANCE_MINIMUM_AGE=18
COMPLIANCE_CONFIRMED_LEGAL_REVIEW=false
COMPLIANCE_CONFIRMED_PAYMENT_PROVIDER_APPROVAL=false
COMPLIANCE_CONFIRMED_AGE_VERIFICATION=false
COMPLIANCE_CONFIRMED_KYC=false
COMPLIANCE_CONFIRMED_AML=false
COMPLIANCE_CONFIRMED_GEO_RESTRICTION=false
COMPLIANCE_CONFIRMED_RESPONSIBLE_PLAY=false
COMPLIANCE_CONFIRMED_SELF_EXCLUSION=false
COMPLIANCE_CONFIRMED_TAX_REPORTING=false
COMPLIANCE_CONFIRMED_TERMS_RULES_REFUNDS=false
COMPLIANCE_CONFIRMED_PRIVACY_POLICY=false
