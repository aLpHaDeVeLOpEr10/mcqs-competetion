# Alternative to Supervisor (use one or the other, not both). One templated unit, three instances:
#   systemctl enable --now mcq-worker@engine-1 mcq-worker@engine-2 mcq-worker@default-1 mcq-worker@default-2 mcq-worker@long-1
# Each instance reads its settings from /etc/mcq/worker-<instance>.env (e.g. /etc/mcq/worker-engine-1.env) containing one of:
#   engine-N:  WORKER_ARGS="database --queue=competition --tries=5 --timeout=30 --sleep=1 --max-time=3600 --memory=256"   (TimeoutStopSec 60)
#   default-N: WORKER_ARGS="database --queue=default --tries=5 --timeout=60 --sleep=2 --max-time=3600 --memory=256"       (TimeoutStopSec 90)
#   long-N:    WORKER_ARGS="database-long --queue=long --tries=3 --timeout=900 --sleep=5 --max-time=7200 --memory=512"    (TimeoutStopSec 960)
# `php artisan queue:restart` makes each worker exit after its current job; Restart=always starts it on the new release.
[Unit]
Description=MCQ Competition queue worker (%i)
After=network.target mariadb.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/mcq/current
EnvironmentFile=/etc/mcq/worker-%i.env
ExecStart=/bin/sh -c 'exec /usr/bin/php /var/www/mcq/current/artisan queue:work $WORKER_ARGS'
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=960
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/mcq/shared/storage /var/log/mcq

[Install]
WantedBy=multi-user.target
