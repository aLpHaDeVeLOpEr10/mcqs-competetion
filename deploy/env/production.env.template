# Production .env TEMPLATE. Copy to /var/www/mcq/shared/.env (owner deploy:www-data, mode 0640)
# and fill in every <...>. NEVER commit the filled-in file. Generate secrets on the server:
#   APP_KEY:            php artisan key:generate --show            (store it in your secret manager too)
#   REVERB_APP_ID:      shuf -i 100000-999999 -n 1
#   REVERB_APP_KEY:     openssl rand -hex 16
#   REVERB_APP_SECRET:  openssl rand -hex 32
#   DB passwords:       openssl rand -base64 33
# Then run: php artisan security:check --production   (must pass)

APP_NAME="MCQ Competition"
APP_ENV=production
APP_KEY=<generated: base64:...>
APP_DEBUG=false
APP_URL=https://quiz.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcq_competition
DB_USERNAME=mcq_app
DB_PASSWORD=<APP_DB_PASSWORD>
# The migration account's credentials are NOT kept here (this file ends up in the config cache,
# which the web process can read). They live in /etc/mcq/migrate.env (owner root:deploy, 0640):
#   DB_USERNAME=mcq_migrate
#   DB_PASSWORD=<MIGRATE_DB_PASSWORD>
# and deploy.sh passes them only to `php artisan migrate`, before the config is cached.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=<smtp host from your mail provider>
MAIL_PORT=587
MAIL_USERNAME=<smtp user>
MAIL_PASSWORD=<smtp password>
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@quiz.example.com
MAIL_FROM_NAME="${APP_NAME}"

# Reverb: browsers and the app reach it at wss://quiz.example.com (nginx proxies /app and /apps);
# the process itself listens on localhost only.
REVERB_APP_ID=<generated>
REVERB_APP_KEY=<generated>
REVERB_APP_SECRET=<generated>
REVERB_HOST=quiz.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=quiz.example.com
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none
# Baked into the JavaScript at build time: build AFTER this file is in place.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Security (docs/SECURITY.md)
SECURITY_HEADERS=true
SECURITY_CSP=enforce
SECURITY_CSP_FORM_ACTIONS=
SECURITY_CSP_CONNECT=
SECURITY_HSTS_MAX_AGE=31536000

# Real money stays OFF until a provider and the legal position are confirmed (docs/PAYMENTS.md).
PAYMENT_GATEWAY=disabled
DEPOSITS_ENABLED=false
COMPETITION_PAID_ENTRIES_ENABLED=false
WITHDRAWALS_ENABLED=false
WITHDRAWAL_PAYOUT_GATEWAY=disabled
FAKE_GATEWAY_ENABLED=false
FAKE_PAYOUT_ENABLED=false

# Queues and operations (docs/OPERATIONS.md)
QUEUE_ENGINE=competition
QUEUE_DEFAULT=default
QUEUE_LONG_CONNECTION=database-long
DB_LONG_QUEUE_RETRY_AFTER=1000
QUEUE_MONITOR_MAX=200
OPS_TICK_STALE_SECONDS=30
CACHE_DASHBOARD_SECONDS=60

DB_TIMEZONE=+00:00
CONTACT_RECIPIENT_EMAIL=<support mailbox for the contact form>
PRIZE_PAYOUTS_ENABLED=false
RESULTS_AUTO_PUBLISH=true

# Real-money launch gate (config/compliance.php, docs/LAUNCH_READINESS.md). Real-money switches stay
# forced OFF until qualified legal/provider review is recorded here. Each CONFIRMED_* means: in place,
# or confirmed not required, by that review. Do not set these to make something "work".
COMPLIANCE_REAL_MONEY_APPROVED=false
COMPLIANCE_APPROVAL_REFERENCE=
COMPLIANCE_PERMITTED_JURISDICTIONS=PK
COMPLIANCE_MINIMUM_AGE=18
COMPLIANCE_CONFIRMED_LEGAL_REVIEW=false
COMPLIANCE_CONFIRMED_PAYMENT_PROVIDER_APPROVAL=false
COMPLIANCE_CONFIRMED_AGE_VERIFICATION=false
COMPLIANCE_CONFIRMED_KYC=false
COMPLIANCE_CONFIRMED_AML=false
COMPLIANCE_CONFIRMED_GEO_RESTRICTION=false
COMPLIANCE_CONFIRMED_RESPONSIBLE_PLAY=false
COMPLIANCE_CONFIRMED_SELF_EXCLUSION=false
COMPLIANCE_CONFIRMED_TAX_REPORTING=false
COMPLIANCE_CONFIRMED_TERMS_RULES_REFUNDS=false
COMPLIANCE_CONFIRMED_PRIVACY_POLICY=false
